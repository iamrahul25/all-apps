{
  "name": "rahuls-digital-shelf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev --config worker/wrangler.toml",
    "build": "tsc -b && vite build",
    "build:worker": "tsc -p worker/tsconfig.json",
    "deploy:backend": "npm run build:worker && wrangler deploy --config worker/wrangler.toml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=20"
  }
}
