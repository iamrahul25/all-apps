# Frontend API URL. Use the Worker URL in production.
VITE_API_URL=http://localhost:8787/api

# Allowed CORS origin for the Worker (optional — defaults to * if unset).
# In production, set this to your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:5173

# NOTE: No database secrets are needed here.
# The D1 database is bound to the Worker via wrangler.toml [[d1_databases]].
# Run `wrangler d1 create rahuls_digital_shelf` once to provision it.